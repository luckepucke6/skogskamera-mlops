# Mall för inference/-tjänstens konfiguration på Pi 3B+. Kopiera till ".env" (gitignorad)
# och fyll i riktiga värden där — committa aldrig den riktiga filen.
#
# cp inference/.env.example ~/skogskamera/.env
# docker run ... --env-file ~/skogskamera/.env ...

# Pi 4:s IP, inte .local — containern kan inte slå upp mDNS-namn. Se CLAUDE.md.
MLFLOW_TRACKING_URI=http://192.168.1.86:5000

# Från @BotFather (/newbot) respektive https://api.telegram.org/bot<TOKEN>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minsta antal sekunder mellan Telegram-notiser. Valfri, default 60.
TELEGRAM_MIN_INTERVAL_S=60
